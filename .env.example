# Скопіюй у .env і заповни. Уникай спецсимволів (@ : / # %) у паролі БД.
POSTGRES_DB=factory
POSTGRES_USER=factory
POSTGRES_PASSWORD=change_me_db

# Логін/пароль адмінки (HTTP Basic)
ADMIN_USER=admin
ADMIN_PASSWORD=change_me_admin

# Часовий пояс для міток часу та «сьогодні» на моніторингу
APP_TIMEZONE=Europe/Kyiv
